{
  "name": "pi-universe-api",
  "version": "1.0.0",
  "description": "π Universe - Multi-Sanctuary Faith Platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "webpack --mode production --config webpack.config.js",
    "build:backend": "tsc && node -e \"require('fs').mkdirSync('dist/db',{recursive:true});require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "build:frontend": "webpack --mode production --config webpack.config.js",
    "build:all": "npm run build:backend && npm run build:frontend",
    "dev:frontend": "webpack serve --mode development --config webpack.config.js",
    "start": "node dist/server.js",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "universe",
    "sanctuary",
    "faith",
    "blockchain"
  ],
  "author": "princessjewelryshop168@gmail.com",
  "license": "MIT",
  "dependencies": {
    "babylonjs": "^6.28.0",
    "babylonjs-loaders": "^6.28.0",
    "bcryptjs": "^2.4.3",
    "cannon-es": "^0.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.2",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
