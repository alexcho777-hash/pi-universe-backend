# π Universe Web - Environment Configuration

# API Configuration
# 生产环境：https://pi-universe-api.onrender.com
# 开发环境：http://localhost:5000
REACT_APP_API_URL=https://pi-universe-api.onrender.com

# Pi Network Configuration
# Testnet: https://testnet.minepi.com
# Mainnet: https://minepi.com
REACT_APP_PI_NETWORK=testnet

# App ID (从 Pi App Studio 获取)
REACT_APP_PI_APP_ID=YOUR_APP_ID_HERE
